# ── Supabase (obbligatorio) ─────────────────────────────────────────────
# Crea un progetto su https://supabase.com e copia i valori da
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Chiave service_role: SOLO lato server, mai esposta al client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Generazione disegni (obbligatorio) ──────────────────────────────────
# API key Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Provider attivo: "claude-svg" (default) oppure "raster" (da implementare
# in src/lib/generation/raster.ts con il servizio di image generation scelto).
GENERATION_PROVIDER=claude-svg
# Modello usato dal provider claude-svg.
GENERATION_MODEL=claude-opus-5

# ── Quote ───────────────────────────────────────────────────────────────
# Disegni gratuiti al giorno per gli utenti con piano "free".
FREE_DAILY_LIMIT=2
# Limite giornaliero per gli utenti "premium" (protezione anti-abuso).
PREMIUM_DAILY_LIMIT=50

# ── Stripe (opzionale: gli endpoint rispondono 501 finché non configurato) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID dell'abbonamento premium (ricorrente), es. price_...
STRIPE_PRICE_ID=

# ── App ─────────────────────────────────────────────────────────────────
# URL pubblico dell'app (usato per i redirect di Stripe e auth).
NEXT_PUBLIC_APP_URL=http://localhost:3000
