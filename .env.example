# ════════════════════════════════════════════════════════════════════════
# PoC: per provare subito l'app basta ANTHROPIC_API_KEY (più sotto).
# Senza Cognito + database l'app parte in modalità demo: niente login,
# disegni salvati sul dispositivo, limite giornaliero best-effort per IP.
# Configurandoli si attiva automaticamente la modalità completa
# (login, quota per utente, persistenza, Stripe).
# ════════════════════════════════════════════════════════════════════════

# ── AWS: login (Cognito) ────────────────────────────────────────────────
# Li stampa lo script infra/aws/04-iam-budget.sh (vedi infra/aws/README.md).
COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Dominio di accesso per Google/Apple (senza https://).
COGNITO_DOMAIN=colora-xxxx.auth.eu-west-1.amazoncognito.com
COGNITO_REGION=eu-west-1

# ── AWS: database (Aurora Serverless v2, Data API) ──────────────────────
# Su Amplify le credenziali arrivano dal "compute role": nessuna chiave AWS.
DB_CLUSTER_ARN=arn:aws:rds:eu-west-1:123456789012:cluster:colora
DB_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:123456789012:secret:rds!cluster-xxxx
DB_NAME=colora
DB_REGION=eu-west-1
# In locale si puo' usare invece un Postgres qualsiasi (ha la precedenza):
# DATABASE_URL=postgres://localhost:5432/colora

# ── Generazione disegni (obbligatorio) ──────────────────────────────────
# API key Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Provider attivo: "mock" (default in questa fase del PoC: qualsiasi
# prompt restituisce a caso uno dei disegni preimpostati, nessuna chiamata
# API), "claude-svg" (generazione vera con Claude, richiede
# ANTHROPIC_API_KEY) oppure "raster" (da implementare
# in src/lib/generation/raster.ts con il servizio di image generation scelto).
GENERATION_PROVIDER=claude-svg
# Modello usato dal provider claude-svg.
GENERATION_MODEL=claude-opus-5

# ── Riuso dei disegni (cache) ───────────────────────────────────────────
# Se qualcuno chiede un soggetto già disegnato (stessa richiesta
# normalizzata, stessa fascia d'età) si riusa quello, senza chiamare il
# modello. Attivo di serie: serve solo la migrazione 0006_cache.sql.
# Un riuso non costa nulla, quindi si può scegliere di non farlo pesare
# sulla quota giornaliera:
CACHE_HITS_FREE=false

# ── Quote ───────────────────────────────────────────────────────────────
# Disegni gratuiti al giorno per gli utenti con piano "free".
FREE_DAILY_LIMIT=2
# Limite giornaliero per gli utenti "premium" (protezione anti-abuso).
PREMIUM_DAILY_LIMIT=50
# Limite giornaliero per IP nella modalità PoC (senza AWS).
DEMO_DAILY_LIMIT=10

# ── Cancello parentale ──────────────────────────────────────────────────
# Segreto per firmare il cookie di sblocco dell'area genitori.
# Obbligatorio con il login attivo. Genera con:
#   openssl rand -hex 32
PARENT_GATE_SECRET=

# ── Stripe (opzionale: gli endpoint rispondono 501 finché non configurato) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID dell'abbonamento premium (ricorrente), es. price_...
STRIPE_PRICE_ID=

# ── App ─────────────────────────────────────────────────────────────────
# URL pubblico dell'app (usato per i redirect di Stripe e auth).
NEXT_PUBLIC_APP_URL=http://localhost:3000
