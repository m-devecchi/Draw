# Copia in config.env e adatta. Gli script la leggono con "source".
# Servono: AWS CLI v2 configurata (aws configure) con un utente che puo'
# creare RDS, Cognito, IAM e Secrets Manager.

# Regione: eu-west-1 (Irlanda) o eu-central-1 (Francoforte).
# Deve essere la stessa dell'app su Amplify.
AWS_REGION=eu-west-1

# Nome comune di tutte le risorse.
APP_NAME=colora

# URL pubblico dell'app (quello di Amplify o il dominio proprio), senza "/" finale.
# Serve a Cognito per i redirect del login con Google/Apple.
APP_URL=https://main.xxxxxxxx.amplifyapp.com

# ── Aurora ─────────────────────────────────────────────────────────────
# Versione di Aurora PostgreSQL (non le varianti "limitless"). Lo scale-to-zero (pausa automatica) e la
# Data API richiedono 13.15+, 14.12+, 15.7+ o 16.3+. Elenco aggiornato:
#   aws rds describe-db-engine-versions --engine aurora-postgresql \
#     --query "DBEngineVersions[].EngineVersion" --output text
AURORA_ENGINE_VERSION=16.11
# Capacita' massima in ACU (1 ACU = ~2 GiB di RAM). 1 basta per iniziare:
# e' anche il tetto di spesa del calcolo.
AURORA_MAX_ACU=1
# Dopo quanti secondi senza richieste il database va in pausa (min 300).
AURORA_PAUSE_SECONDS=300

# ── Cognito ────────────────────────────────────────────────────────────
# Prefisso del dominio di accesso: <prefisso>.auth.<regione>.amazoncognito.com
# Deve essere unico in tutta AWS.
COGNITO_DOMAIN_PREFIX=colora-CAMBIAMI

# Facoltativo: login con Google (credenziali OAuth da Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facoltativo: login con Apple.
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Percorso del file .p8 della chiave privata Apple.
APPLE_PRIVATE_KEY_FILE=
